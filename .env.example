# Model service the gateway talks to (always localhost)
MODELS_URL=http://127.0.0.1:8000
# 1 = `make dev` starts mocks/mock-models instead of services/models
USE_MOCK_MODELS=1
# 1 = allow sending audio/text to a hosted fallback. Off by default (local-first).
ALLOW_REMOTE_FALLBACK=0

# Model service backend: mlx (demo Mac) or cuda (RTX 3080 server). `make models` installs that uv extra.
MODELS_BACKEND=mlx
# Pinned model IDs (services/models). Leave STT_MODEL/TTS_MODEL empty for the backend's defaults in
# services/models/app/config.py (MLX: mlx-community/whisper-large-v3-turbo + mlx-community/Qwen3-TTS-12Hz-0.6B-Base-bf16;
# CUDA: openai/whisper-large-v3-turbo + Qwen/Qwen3-TTS-12Hz-0.6B-Base).
STT_MODEL=
TTS_MODEL=
# Suggestions run in a local Ollama on both backends: `ollama pull gemma4:e4b`, keep `ollama serve` running.
SUGGEST_MODEL=gemma4:e4b
OLLAMA_URL=http://127.0.0.1:11434

# Gateway
DATA_DIR=./data
GATEWAY_ADDR=:8443
# 1 = accept listener.say (the test bench types what the listener said). `make demo` sets 0.
DEV_TOOLS=1
# mkcert output, e.g. `mkcert -cert-file certs/dev.pem -key-file certs/dev-key.pem <laptop-ip> localhost`
TLS_CERT=./certs/dev.pem
TLS_KEY=./certs/dev-key.pem

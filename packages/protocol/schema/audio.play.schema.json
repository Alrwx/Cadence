{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audio.play",
  "description": "Play a synthesized clip on the phone.",
  "x-direction": "gateway → phone",
  "type": "object",
  "properties": {
    "clipId": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "suggestion",
        "instant",
        "saved",
        "typed"
      ]
    }
  },
  "required": [
    "clipId",
    "url",
    "text",
    "source"
  ],
  "additionalProperties": false
}

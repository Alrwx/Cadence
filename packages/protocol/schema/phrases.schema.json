{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phrases",
  "description": "All saved-phrase groups; sent on connect and after any change.",
  "x-direction": "gateway → headset",
  "type": "object",
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "audioReady": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "text",
                "audioReady"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "groups"
  ],
  "additionalProperties": false
}
